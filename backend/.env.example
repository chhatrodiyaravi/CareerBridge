MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
API_PORT=5000

# Cloudinary credentials are only used by the backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP account details for password-reset OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=CareerBridge <no-reply@example.com>

# Set these locally in backend/.env before running npm run seed:companies.
COMPANY_SEED_PASSWORD_1=
COMPANY_SEED_PASSWORD_2=
COMPANY_SEED_PASSWORD_3=
COMPANY_SEED_PASSWORD_4=
COMPANY_SEED_PASSWORD_5=
COMPANY_SEED_PASSWORD_6=
COMPANY_SEED_PASSWORD_7=
COMPANY_SEED_PASSWORD_8=
COMPANY_SEED_PASSWORD_9=
COMPANY_SEED_PASSWORD_10=
